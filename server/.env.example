# Copy to .env and point systemd or your shell at it.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.org,localhost,127.0.0.1

ES_URL=http://127.0.0.1:9200
ES_INDEX=manuscripts
# ES_USER=elastic
# ES_PASSWORD=
# ES_API_KEY=
# ES_CA_CERT=/etc/elasticsearch/certs/http_ca.crt
# ES_VERIFY=1

# nginx serves index.html in production; leave this on for `runserver`.
SERVE_VIEWER=1
